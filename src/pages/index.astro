---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE, CATEGORIES } from '../site.config.js';

const all = [];
const categoryStats = [];
for (const cat of CATEGORIES) {
  const entries = await getCollection(cat.collection as any);
  const published = (entries as any[]).filter((e) => !e.data.draft);
  categoryStats.push({ ...cat, count: published.length });
  for (const e of published) all.push({ ...e, category: cat.slug, categoryLabel: cat.label });
}
all.sort((a, b) => b.data.lastUpdated.valueOf() - a.data.lastUpdated.valueOf());
const recent = all.slice(0, 12);
const profileCount = all.length;
const countryCount = new Set(all.map((entry: any) => entry.data.country).filter(Boolean)).size;

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(d);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  publisher: { '@type': 'Organization', name: SITE.publisher, url: SITE.url },
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE.url}/search/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<Base title={SITE.name} jsonLd={jsonLd}>
  <div class="home-shell">
    <section class="home-hero wrap wrap--centred" aria-labelledby="home-title">
      <div class="home-hero__copy">
        <p class="eyebrow"><span class="eyebrow-mark" aria-hidden="true"></span> Independent reference profiles</p>
        <h1 id="home-title">Find the record<br /><em>behind the claim.</em></h1>
        <p class="lede">
          FactsLedger turns scattered public records into clear, source-backed profiles of people, places, institutions,
          organizations, events and species — without copying an encyclopedia or hiding the trail.
        </p>
        <div class="home-hero__actions">
          <a class="btn-primary" href="/search/">Search the archive <span aria-hidden="true">↗</span></a>
          <a class="btn-secondary" href="/about/methodology/">See how we research <span aria-hidden="true">↗</span></a>
        </div>
        <form class="home-search" action="/search/" method="get" role="search">
          <label for="home-search-input">Search a person, place, institution or event</label>
          <div class="home-search__row">
            <input id="home-search-input" type="search" name="q" placeholder="Try “Dario Amodei” or “Westerplatte”" autocomplete="off" />
            <button type="submit">Search <span aria-hidden="true">↗</span></button>
          </div>
        </form>
      </div>

      <aside class="evidence-card" aria-label="FactsLedger research promise">
        <div class="evidence-card__top"><span>FACTSLEDGER / 2026</span><span class="evidence-card__dot" aria-hidden="true"></span></div>
        <p class="evidence-card__quote">A reference becomes useful when you can see <em>why</em> a sentence is there.</p>
        <div class="evidence-card__rule" aria-hidden="true"></div>
        <ul class="evidence-card__list">
          <li><span class="evidence-card__index">01</span><span class="evidence-card__body"><strong>Source-led</strong><span>Claims point to the record they rely on.</span></span></li>
          <li><span class="evidence-card__index">02</span><span class="evidence-card__body"><strong>Independent</strong><span>Primary material and published reporting are read directly.</span></span></li>
          <li><span class="evidence-card__index">03</span><span class="evidence-card__body"><strong>Open to correction</strong><span>Gaps and disagreements stay visible.</span></span></li>
        </ul>
        <div class="evidence-card__footer"><span class="evidence-card__footer-note">Built for curious readers</span><a href="/about/source-policy/">Read the source policy <span aria-hidden="true">↗</span></a></div>
      </aside>
    </section>

    <section class="proof-strip" aria-label="FactsLedger archive signals">
      <div class="wrap wrap--centred proof-strip__inner">
        <div class="proof-strip__stat"><strong>{profileCount}</strong><span>published profiles</span></div>
        <div class="proof-strip__stat"><strong>{categoryStats.length}</strong><span>reference categories</span></div>
        <div class="proof-strip__stat"><strong>{countryCount || '—'}</strong><span>countries represented</span></div>
        <div class="proof-strip__note"><span class="proof-strip__pulse" aria-hidden="true"></span> Updated continuously from public records</div>
      </div>
    </section>

    <section class="home-visual-break wrap wrap--centred" aria-label="Research visuals">
      <figure class="home-visual-break__main">
        <img src="/images/home/archive-shelves.jpg" alt="Curved library shelves filled with books and archival material" width="1798" height="1200" loading="lazy" decoding="async" />
        <figcaption><span>Inside the archive</span><span>Records worth following</span></figcaption>
      </figure>
      <figure class="home-visual-break__inset">
        <img src="/images/home/research-desk.jpg" alt="Open research notebook and glasses on a desk" width="1800" height="1012" loading="lazy" decoding="async" />
        <figcaption><span>Research notes</span><span>Read, compare, verify</span></figcaption>
      </figure>
    </section>

    <main class="wrap wrap--centred home-main">
      <section class="home-section" aria-labelledby="categories-title">
        <div class="section-heading section-heading--home">
          <div><p class="section-kicker">01 / Explore the archive</p><h2 id="categories-title">Start with a subject.</h2></div>
          <a href="/search/">Search all profiles <span aria-hidden="true">↗</span></a>
        </div>
        <ul class="cards cards--home">
          {categoryStats.map((c) => (
            <li class="card card--home">
              <a class="card__link" href={`/${c.slug}/`} aria-label={`Browse ${c.label}`}>
                <span class="card__top"><span class="card__number">{String(categoryStats.indexOf(c) + 1).padStart(2, '0')}</span><span class="card__count">{c.count} {c.count === 1 ? 'profile' : 'profiles'}</span></span>
                <h3>{c.label}</h3>
                <p>{c.blurb}</p>
                <span class="card__arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="home-section home-section--latest" aria-labelledby="latest-title">
        <div class="section-heading section-heading--home">
          <div><p class="section-kicker">02 / Follow the record</p><h2 id="latest-title">Recently researched.</h2></div>
          {recent[0] && <span>Updated {fmt(recent[0].data.lastUpdated)}</span>}
        </div>
        {recent.length === 0 ? (
          <p class="empty-state">No profiles published yet.</p>
        ) : (
          <ul class="index-list index-list--home">
            {recent.map((e: any) => (
              <li class="index-list__row">
                <div class="index-list__content">
                  <a href={`/${e.category}/${e.id}/`}>{e.data.title}<span class="row-arrow" aria-hidden="true">↗</span></a>
                  <p>{e.data.summary}</p>
                </div>
                <aside class="index-list__aside" aria-label={`${e.data.title} metadata`}>
                  <strong>{e.categoryLabel}</strong>
                  <span>{e.data.country}</span>
                  <span>{e.data.sources.length} sources</span>
                  <time datetime={e.data.lastUpdated.toISOString()}>{fmt(e.data.lastUpdated)}</time>
                </aside>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class="research-path" aria-labelledby="path-title">
        <div class="research-path__intro"><p class="section-kicker">03 / The method</p><h2 id="path-title">Read the trail,<br /><em>not just the headline.</em></h2><p>Every profile is a compact research file: a clear identity, the important context, and the sources that let you check the story yourself.</p><a class="text-link" href="/about/methodology/">Explore the full methodology <span aria-hidden="true">↗</span></a></div>
        <ol class="research-path__steps">
          <li><span>01</span><div><strong>Define the entity</strong><p>Separate the subject from similarly named people, places and organizations.</p></div></li>
          <li><span>02</span><div><strong>Read the sources</strong><p>Use public records, institutional material and independent reporting — not summaries alone.</p></div></li>
          <li><span>03</span><div><strong>Show the uncertainty</strong><p>Keep open items, corrections and source disagreements visible to the reader.</p></div></li>
        </ol>
      </section>

      <div class="home-panels home-panels--conversion">
        <section class="home-panel home-panel--plain">
          <p class="section-kicker">A different kind of reference</p>
          <h2>Useful context without the noise.</h2>
          <p>{SITE.name} is not an encyclopedia and does not reproduce content from one. Profiles are researched independently from primary and published sources, with unresolved points listed openly rather than presented as fact.</p>
          <a class="text-link" href="/about/">Meet the editorial team <span aria-hidden="true">↗</span></a>
        </section>
        <section class="home-panel home-panel--support" id="support">
          <p class="section-kicker">Help keep the archive independent</p>
          <h2>Support the research.</h2>
          <p>Every profile takes careful source-reading before publication. Your support helps fund fact-checking, source access and the continued maintenance of this public reference.</p>
          <a class="btn-donate" href={SITE.donateUrl} target="_blank" rel="noopener noreferrer" aria-label="Support FactsLedger research on Ko-fi">Support FactsLedger <span aria-hidden="true">↗</span></a>
        </section>
      </div>
    </main>
  </div>
</Base>
